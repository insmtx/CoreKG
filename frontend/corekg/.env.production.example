# .env.production.example
# 用法：非 Compose 部署可复制为 .env.production 后按实际站点填写。
# Docker Compose 部署使用 Nginx 同源代理，无需配置 VITE_API_URL；
# VITE_LOGIN_URL 留空时自动使用浏览器当前站点。
VITE_API_URL=https://api.example.com
VITE_LOGIN_URL=https://account.example.com
VITE_META_DESCRIPTION=<meta name="description" content="知识图谱引擎、多模态知识库、企业级AI平台、文档解析、智能问答系统、AI Agent创建、问答对知识库、文档级问答">
# 部署模式配置 (h3c 或 jiefang)
VITE_DEPLOY_MODE=jiefang
